{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "tmetric",
  "title": "TMetric Timer",
  "description": "Start and stop TMetric timers from Raycast",
  "icon": "command-icon.png",
  "author": "Riad Afridi Shibly",
  "categories": [
    "Productivity"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "start-timer",
      "title": "Start Timer",
      "description": "Start a new TMetric timer",
      "mode": "view"
    },
    {
      "name": "stop-timer",
      "title": "Stop Timer",
      "description": "Stop the currently running TMetric timer",
      "mode": "no-view"
    },
    {
      "name": "timer-status",
      "title": "Timer Status",
      "description": "View the current TMetric timer status",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "apiToken",
      "title": "API Token",
      "description": "Your TMetric API token",
      "type": "password",
      "required": true
    },
    {
      "name": "useMockApi",
      "title": "Use Mock API",
      "description": "Use the local mock server instead of real TMetric (for testing)",
      "type": "checkbox",
      "default": false,
      "label": "Enable Mock API",
      "required": false
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.93.2",
    "@raycast/utils": "^1.17.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.11",
    "@types/node": "~22.13.4",
    "@types/react": "^19.0.8",
    "concurrently": "^9.2.1",
    "eslint": "^8.57.0",
    "prettier": "^3.4.2",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "scripts": {
    "build": "ray build",
    "dev": "concurrently --names server,raycast --prefix-colors blue,green \"tsx server/mock-server.ts\" \"ray develop\"",
    "dev:raycast": "ray develop",
    "dev:server": "tsx server/mock-server.ts",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish",
    "test": "vitest run"
  }
}
